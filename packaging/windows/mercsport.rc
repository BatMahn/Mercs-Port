/* Windows resources for mercs.exe: the program icon (Explorer, taskbar, and SDL's window class all use icon 1)
 * and version information. mercsport.ico: the Mercenaries icon (packaging/macos/mercsport.icns), its 16 / 32 / 64 /
 * 128 / 256 frames as drawn and 24 / 48 resampled. */
1 ICON "mercsport.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "MechWarrior 2: Mercenaries (64-bit port)"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
      VALUE "ProductName", "Mercs-Port"
      VALUE "OriginalFilename", "mercs.exe"
      VALUE "InternalName", "mercs"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
